{
  "id": "melonds",
  "kind": "emulator",
  "label": "Nintendo DS",
  "emulatorName": "melonDS",
  "platform": "DS",
  "family": "Nintendo",
  "color": "#0096ff",
  "order": 9,
  "install": {
    "provider": "flatpak",
    "appIds": ["net.kuribo64.melonDS"]
  },
  "launch": {
    "path": "flatpak",
    "args": "run @APPID@ -f",
    "preferIfPresent": {
      "path": "lib/melon",
      "args": "-f"
    }
  },
  "roms": {
    "dir": "emu/melonds",
    "extensions": [
      "*.nds",
      "*.zip"
    ]
  },
  "config": {
    "dest": "@FLATPAK_CONFIG@/melonDS",
    "nativeDest": "@HOME@/.config/melonDS"
  },
  "controllers": {
    "maxPlayers": 1,
    "order": 9,
    "strategy": "snapshot-or-synth",
    "target": "melonDS.toml",
    "seedMustNotContain": [
      "^Device = \"[^\"]"
    ]
  },
  "overlay": {
    "wmClass": {
      "linux": [
        "melonds",
        "melonDS",
        "net.kuribo64.melonDS",
        "AppRun.wrapped"
      ]
    },
    "asset": "melonds.png"
  },
  "scraper": {
    "tgdbId": 8,
    "screenscraper": [
      15
    ],
    "libretro": [
      "Nintendo - Nintendo DS",
      "Nintendo - Nintendo DS (Download Play)"
    ],
    "mediaAlias": [
      "nds"
    ]
  },
  "perGame": {
    "supported": false,
    "why": "melonDS keeps one configuration and offers no per-title file to write. Nothing to point at."
  },
  "hostAccess": {
    "uinput": true,
    "ptrace": true
  },
  "files": [
    {
      "src": "files/melonds_layout_toggle.py",
      "dest": "@HOME@/.local/share/gamecore/layout-toggle/melonds/melonds_layout_toggle.py",
      "owner": "user",
      "mode": "755"
    }
  ],
  "services": [
    {
      "unit": "files/melonds-layout-toggle.service",
      "scope": "user",
      "enable": true
    }
  ]
}
