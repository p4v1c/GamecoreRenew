{
  "id": "azahar",
  "kind": "emulator",
  "label": "Nintendo 3DS",
  "emulatorName": "Azahar",
  "platform": "3DS",
  "family": "Nintendo",
  "color": "#ff0096",
  "order": 0,
  "install": {
    "provider": "flatpak",
    "appIds": ["org.azahar_emu.Azahar"]
  },
  "launch": {
    "path": "flatpak",
    "args": "run @APPID@ -f"
  },
  "roms": {
    "dir": "emu/azahar",
    "extensions": [
      "*.3ds",
      "*.cia",
      "*.zip"
    ]
  },
  "config": {
    "dest": "@FLATPAK_CONFIG@/azahar-emu"
  },
  "controllers": {
    "maxPlayers": 1,
    "order": 1,
    "strategy": "snapshot-restore",
    "target": "qt-config.ini",
    "seedMustNotContain": [
      "engine[:$]0?sdl"
    ]
  },
  "overlay": {
    "wmClass": {
      "linux": [
        "azahar",
        "Azahar",
        "citra-qt",
        "org.azahar_emu.azahar"
      ]
    },
    "asset": "azahar.png"
  },
  "scraper": {
    "tgdbId": 4912,
    "screenscraper": [
      17
    ],
    "libretro": [
      "Nintendo - Nintendo 3DS"
    ],
    "mediaAlias": [
      "3ds"
    ]
  },
  "perGame": {
    "supported": false,
    "why": "A 3DS dump carries its Title ID in the NCSD/NCCH header, and no reader in backend/services/gameid.py opens one yet. Azahar does keep per-title configs; what is missing is the name to file them under."
  }
}
