{
  "id": "switch",
  "kind": "emulator",
  "label": "Nintendo Switch",
  "emulatorName": "Ryujinx",
  "platform": "Switch",
  "family": "Nintendo",
  "color": "#e6001a",
  "order": 3,
  "install": {
    "provider": "flatpak",
    "appIds": [
      "io.github.ryubing.Ryujinx"
    ]
  },
  "launch": {
    "path": "flatpak",
    "args": "run @APPID@",
    "formerArgs": [
      "run @APPID@ -f -g"
    ]
  },
  "roms": {
    "dir": "emu/switch",
    "extensions": [
      "*.xci",
      "*.nsp"
    ]
  },
  "config": {
    "dest": "@FLATPAK_CONFIG@/Ryujinx"
  },
  "bios": {
    "dir": "@FLATPAK_CONFIG@/Ryujinx/system",
    "files": [
      {
        "file": "prod.keys",
        "required": true,
        "note": "Switch console keys. Without them Ryujinx decrypts nothing and stops on a black window."
      },
      {
        "file": "title.keys",
        "required": false,
        "note": "Per-title keys. Only some dumps need them, so a box without this file is a working box."
      }
    ]
  },
  "controllers": {
    "maxPlayers": 4,
    "order": 0,
    "strategy": "guid-rebind",
    "target": "Config.json",
    "seedMustNotContain": [
      "\"id\":\\s*\"\\d+-[0-9a-f]{8}-"
    ]
  },
  "scraper": {
    "tgdbId": 4971,
    "screenscraper": [
      225
    ],
    "libretro": [
      "Nintendo - Switch"
    ],
    "mediaAlias": [
      "switch"
    ]
  },
  "profileSaves": {
    "dirs": [
      {
        "config": "bis/user/save",
        "as": "user-save"
      },
      {
        "config": "bis/system/save/8000000000000000",
        "as": "save-index"
      }
    ]
  },
  "perGame": {
    "supported": false,
    "why": "Ryujinx has no per-title configuration file: its settings are global, and a title override is a fork feature that this pack's appIds do not point at."
  },
  "postInstall": [
    {
      "run": "steps/import-eden.sh",
      "label": "copy keys, firmware and saves from Eden",
      "timeoutSec": 300
    }
  ]
}
