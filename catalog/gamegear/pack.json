{
  "id": "gamegear",
  "kind": "emulator",
  "label": "Sega Game Gear",
  "emulatorName": "RetroArch / genesis-plus-gx",
  "platform": "Game Gear",
  "family": "Sega",
  "color": "#37474f",
  "order": 23,
  "install": {
    "provider": "pacman",
    "packages": [
      "retroarch",
      "libretro-genesis-plus-gx"
    ]
  },
  "launch": {
    "path": "/usr/bin/python3",
    "args": "'@GAMECORE_PATH@/scripts/gamecore-retroarch-launch.py' --config '@HOME@/.config/gamecore-retroarch/gamegear.cfg' --core /usr/lib/libretro/genesis_plus_gx_libretro.so --"
  },
  "roms": {
    "dir": "emu/gamegear",
    "extensions": [
      "*.gg"
    ]
  },
  "config": {
    "dest": "@HOME@/.config/gamecore-retroarch"
  },
  "controllers": {
    "maxPlayers": 1,
    "order": 23,
    "strategy": "snapshot-restore",
    "target": "gamegear.cfg",
    "seedMustNotContain": [
      "^input_player[1-4]_.*(?:_btn|_axis|joypad_index)\\s*="
    ]
  },
  "overlay": {
    "wmClass": {
      "linux": [
        "retroarch",
        "RetroArch"
      ]
    },
    "asset": "gamegear.png"
  },
  "scraper": {
    "libretro": [
      "Sega - Game Gear"
    ],
    "mediaAlias": [
      "game gear"
    ]
  },
  "perGame": {
    "supported": false,
    "why": "GameCore owns the per-system RetroArch controller lines only; core options and per-game remaps are deliberately left to RetroArch/the owner."
  }
}
