{
  "id": "dolphin",
  "kind": "emulator",
  "label": "GameCube / Wii",
  "emulatorName": "Dolphin",
  "platform": "GameCube/Wii",
  "family": "Nintendo",
  "color": "#ff8c00",
  "order": 2,
  "install": {
    "provider": "flatpak",
    "appIds": ["org.DolphinEmu.dolphin-emu"]
  },
  "launch": {
    "path": "flatpak",
    "args": "run org.DolphinEmu.dolphin-emu -b"
  },
  "roms": {
    "dir": "emu/dolphin",
    "extensions": [
      "*.iso",
      "*.gcm",
      "*.rvz",
      "*.wbfs",
      "*.wad",
      "*.zip"
    ]
  },
  "config": {
    "dest": "@FLATPAK_CONFIG@/dolphin-emu"
  },
  "controllers": {
    "maxPlayers": 4,
    "order": 5,
    "strategy": "rewrite-device-line",
    "target": [
      "GCPadNew.ini",
      "WiimoteNew.ini"
    ],
    "seedMustNotContain": [
      "^Device = (?:SDL|evdev)/"
    ]
  },
  "localMedia": {
    "format": "gcwii",
    "discTag": "wii"
  },
  "scraper": {
    "tgdbId": 2,
    "screenscraper": [
      13,
      16
    ],
    "libretro": [
      "Nintendo - GameCube",
      "Nintendo - Wii"
    ],
    "mediaAlias": [
      "gamecube",
      "wii"
    ]
  }
}
