{
  "id": "cemu",
  "kind": "emulator",
  "label": "Wii U",
  "emulatorName": "Cemu",
  "platform": "Wii U",
  "family": "Nintendo",
  "color": "#00b48c",
  "order": 1,
  "install": {
    "provider": "flatpak",
    "appIds": ["info.cemu.Cemu"]
  },
  "launch": {
    "path": "flatpak",
    "args": "run @APPID@ -f -g"
  },
  "roms": {
    "dir": "emu/cemu",
    "extensions": [
      "*.wux",
      "*.rpx",
      "*.iso",
      "*.zip"
    ]
  },
  "config": {
    "dest": "@FLATPAK_CONFIG@/Cemu"
  },
  "bios": {
    "dir": "@FLATPAK_DATA@/Cemu",
    "files": [
      {
        "file": "keys.txt",
        "required": false,
        "note": "Wii U title keys, needed to read an encrypted retail dump. A decrypted game runs without it."
      }
    ]
  },
  "controllers": {
    "maxPlayers": 1,
    "order": 3,
    "strategy": "snapshot-restore",
    "target": "controllerProfiles/controller0.xml",
    "seedMustNotContain": [
      "<uuid>[^<]",
      "<display_name>[^<]"
    ]
  },
  "scraper": {
    "tgdbId": 38,
    "screenscraper": [
      18
    ],
    "libretro": [
      "Nintendo - Wii U"
    ],
    "mediaAlias": [
      "wiiu"
    ]
  },
  "perGame": {
    "supported": true,
    "path": "@FLATPAK_CONFIG@/Cemu/gameProfiles/@GAMEID@.ini",
    "format": "ini",
    "key": "wiiu",
    "merge": "own-keys"
  }
}
