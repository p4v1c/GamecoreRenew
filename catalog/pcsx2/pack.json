{
  "id": "pcsx2",
  "kind": "emulator",
  "label": "PlayStation 2",
  "emulatorName": "PCSX2",
  "platform": "PS2",
  "family": "Sony",
  "color": "#003087",
  "order": 5,
  "install": {
    "provider": "flatpak",
    "appIds": ["net.pcsx2.PCSX2"]
  },
  "launch": {
    "path": "flatpak",
    "args": "run @APPID@ -fullscreen",
    "preferIfPresent": {
      "path": "lib/pcsx2",
      "args": "-fullscreen"
    }
  },
  "roms": {
    "dir": "emu/pcsx2",
    "extensions": [
      "*.iso",
      "*.bin",
      "*.chd",
      "*.zip"
    ]
  },
  "config": {
    "dest": "@FLATPAK_CONFIG@/PCSX2/inis"
  },
  "bios": {
    "dir": "@FLATPAK_CONFIG@/PCSX2/bios",
    "files": [
      {
        "file": "ps2-0150e-20001228.bin",
        "md5": "838544f12de9b0abc90811279ee223c8",
        "required": true,
        "note": "PlayStation 2 boot ROM. GameCore's PCSX2 configuration names this exact file, so PCSX2 starts with this one or with none."
      }
    ]
  },
  "controllers": {
    "maxPlayers": 4,
    "order": 7,
    "strategy": "sdl-index-clone",
    "target": "PCSX2.ini",
    "padType": "DualShock2",
    "multitap": {
      "section": "Pad",
      "key": "MultitapPort1",
      "value": "true",
      "offValue": "false",
      "fromPlayer": 3
    }
  },
  "overlay": {
    "wmClass": {
      "linux": [
        "pcsx2",
        "PCSX2",
        "io.github.PCSX2.PCSX2",
        "AppRun.wrapped",
        "pcsx2-qt",
        "net.pcsx2.PCSX2"
      ]
    },
    "asset": "pcsx2.png"
  },
  "localMedia": {
    "format": "playstation",
    "discTag": "ps2"
  },
  "scraper": {
    "tgdbId": 11,
    "screenscraper": [
      58
    ],
    "libretro": [
      "Sony - PlayStation 2"
    ],
    "mediaAlias": [
      "ps2"
    ]
  },
  "perGame": {
    "supported": false,
    "why": "PCSX2 names a per-game ini after the serial AND the disc CRC, and nothing here computes the CRC. Half an identity would name a file PCSX2 never opens."
  }
}
