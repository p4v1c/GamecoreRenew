{
  "id": "rpcs3",
  "kind": "emulator",
  "label": "PlayStation 3",
  "emulatorName": "RPCS3",
  "platform": "PS3",
  "family": "Sony",
  "color": "#00439c",
  "order": 6,
  "install": {
    "provider": "flatpak",
    "appId": "net.rpcs3.RPCS3"
  },
  "launch": {
    "path": "flatpak",
    "args": "run net.rpcs3.RPCS3 --fullscreen --no-gui",
    "preferIfPresent": {
      "path": "lib/rpcs3",
      "args": "--fullscreen --no-gui"
    }
  },
  "roms": {
    "dir": "emu/rpcs3",
    "scanDirs": true,
    "extensions": []
  },
  "config": {
    "dest": "@FLATPAK_CONFIG@/rpcs3"
  },
  "bios": {
    "dir": "@FLATPAK_CONFIG@/rpcs3/dev_flash/sys/external",
    "files": [
      {
        "file": "liblv2.sprx",
        "required": true,
        "note": "PS3 firmware, installed by RPCS3 itself from a PUP the owner supplies. This one module is the marker that the install finished — no md5, because it changes with every firmware version."
      }
    ]
  },
  "controllers": {
    "maxPlayers": 4,
    "order": 6,
    "strategy": "rewrite-player-block",
    "target": "input_configs/global/Default.yml",
    "seedMustNotContain": [
      "^\\s*Device:\\s*(?!\"\"|\"Null\")\\S"
    ]
  },
  "localMedia": {
    "format": "ps3"
  },
  "scraper": {
    "tgdbId": 12,
    "screenscraper": [
      59
    ],
    "libretro": [
      "Sony - PlayStation 3"
    ],
    "mediaAlias": [
      "ps3"
    ]
  }
}
