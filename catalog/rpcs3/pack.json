{
  "id": "rpcs3",
  "kind": "emulator",
  "label": "PlayStation 3",
  "emulatorName": "RPCS3",
  "platform": "PS3",
  "family": "Sony",
  "color": "#00439c",
  "order": 6,
  "install": {
    "provider": "flatpak",
    "appIds": ["net.rpcs3.RPCS3"]
  },
  "launch": {
    "path": "flatpak",
    "args": "run @APPID@ --fullscreen --no-gui",
    "preferIfPresent": {
      "path": "lib/rpcs3",
      "args": "--fullscreen --no-gui"
    }
  },
  "roms": {
    "dir": "emu/rpcs3",
    "scanDirs": true,
    "extensions": []
  },
  "config": {
    "dest": "@FLATPAK_CONFIG@/rpcs3"
  },
  "bios": {
    "dir": "@FLATPAK_CONFIG@/rpcs3/dev_flash/sys/external",
    "files": [
      {
        "file": "liblv2.sprx",
        "required": true,
        "note": "PS3 firmware. Install it from RPCS3 itself, from a PUP you supply — this module is what says the install finished."
      }
    ]
  },
  "usb": [
    {
      "vidPid": "054c:0268",
      "class": "gamepad",
      "label": "DualShock 3",
      "udevRule": "KERNEL==\"hidraw*\", ATTRS{idVendor}==\"054c\", ATTRS{idProduct}==\"0268\", MODE=\"0666\"",
      "note": "RPCS3's native DS3 handler reads the pad over hidraw, which is what gives it motion and pressure-sensitive buttons a generic SDL pad cannot report. The pad also works as an ordinary SDL controller without this — only the PS3-specific inputs are lost."
    }
  ],
  "controllers": {
    "maxPlayers": 4,
    "order": 6,
    "strategy": "rewrite-player-block",
    "target": "input_configs/global/Default.yml",
    "seedMustNotContain": [
      "^\\s*Device:\\s*(?!\"\"|\"Null\")\\S"
    ]
  },
  "localMedia": {
    "format": "ps3"
  },
  "scraper": {
    "tgdbId": 12,
    "screenscraper": [
      59
    ],
    "libretro": [
      "Sony - PlayStation 3"
    ],
    "mediaAlias": [
      "ps3"
    ]
  }
}
