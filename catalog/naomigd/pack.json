{
  "id": "naomigd",
  "kind": "emulator",
  "label": "Sega Naomi GD-ROM",
  "emulatorName": "RetroArch / flycast",
  "platform": "Naomi GD-ROM",
  "family": "Sega",
  "color": "#00695c",
  "order": 31,
  "install": {
    "provider": "pacman",
    "packages": [
      "retroarch",
      "libretro-flycast"
    ]
  },
  "launch": {
    "path": "/usr/bin/python3",
    "args": "'@GAMECORE_PATH@/scripts/gamecore-retroarch-launch.py' --config '@HOME@/.config/gamecore-retroarch/naomigd.cfg' --core /usr/lib/libretro/flycast_libretro.so --"
  },
  "roms": {
    "dir": "emu/naomigd",
    "extensions": [
      "*.zip",
      "*.7z"
    ]
  },
  "config": {
    "dest": "@HOME@/.config/gamecore-retroarch"
  },
  "controllers": {
    "maxPlayers": 2,
    "order": 31,
    "strategy": "snapshot-restore",
    "target": "naomigd.cfg",
    "seedMustNotContain": [
      "^input_player[1-4]_.*(?:_btn|_axis|joypad_index)\\s*="
    ]
  },
  "overlay": {
    "wmClass": {
      "linux": [
        "retroarch",
        "RetroArch"
      ]
    },
    "asset": "naomigd.png"
  },
  "scraper": {
    "libretro": [
      "Sega - Naomi"
    ],
    "mediaAlias": [
      "naomi gd-rom"
    ]
  },
  "perGame": {
    "supported": false,
    "why": "GameCore owns the per-system RetroArch controller lines only; core options and per-game remaps are deliberately left to RetroArch/the owner."
  },
  "bios": {
    "dir": "@HOME@/.config/gamecore-retroarch/system",
    "files": [
      {
        "file": "dc/naomigd.zip",
        "required": false,
        "note": "External NAOMI GD-ROM BIOS archive; Flycast can also load the required BIOS ROM from a non-merged game or parent archive, so absence must not hard-block launch."
      }
    ]
  }
}
