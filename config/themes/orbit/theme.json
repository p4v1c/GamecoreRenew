{
  "id": "orbit",
  "name": "Orbit",
  "version": "3.3.0",
  "api": 6,
  "description": "A cinematic console interface: games, consoles, library and applications, with real suspend and resume.",
  "author": "GameCore Community",
  "entry": "index.js",
  "styles": "theme.css",
  "preview": "preview.svg",
  "provides": [
    "splash",
    "shell"
  ],
  "boot": {
    "background": "#080f1d"
  },
  "home": {
    "rows": 1,
    "paged": false
  },
  "launch": {
    "ms": 500
  },
  "settings": {
    "pages": [
      "wifi",
      "audio",
      "bluetooth",
      "standby",
      "catalog",
      "bios",
      "storage",
      "themes",
      "update",
      "desktop"
    ]
  }
}
