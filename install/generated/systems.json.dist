[
  {
    "id": "azahar",
    "type": "emulator",
    "label": "Nintendo 3DS",
    "platform": "3DS",
    "color": "#ff0096",
    "iconPath": "assets/logos/azahar.png",
    "path": "flatpak",
    "args": "run @APPID@ -f",
    "romsPath": "emu/azahar/",
    "extensions": [
      "*.3ds",
      "*.cia",
      "*.zip"
    ],
    "libretroSystems": [
      "Nintendo - Nintendo 3DS"
    ]
  },
  {
    "id": "cemu",
    "type": "emulator",
    "label": "Wii U",
    "platform": "Wii U",
    "color": "#00b48c",
    "iconPath": "assets/logos/cemu.png",
