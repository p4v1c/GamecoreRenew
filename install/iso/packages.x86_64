# Packages baked into the GameCore ISO.
#
# READ THIS BEFORE ADDING A LINE ANYWHERE ELSE.
#
# The install performed by gamecore-disk-install.sh is a COPY of this live root
# onto the target disk. There is no `pacstrap` and no mirror: a package missing
# from this file is missing from every box installed from the ISO, and arch.sh
# then reaches `pacman -S --needed` with no network and dies — or worse, warns
# and produces a box with no Vulkan driver.
#
# So this file has to be a superset of install/arch.sh's PKGS array.
# backend/tests/test_iso_profile.py asserts exactly that, because the two lists
# drift silently otherwise: adding a package to arch.sh is a one-line change
# that nobody thinks of as touching the ISO.

# ── Base system ──────────────────────────────────────────────────
base
base-devel
linux
linux-firmware
linux-headers
mkinitcpio
# The initramfs hooks that find and mount the squashfs. Without it the ISO
# builds happily and then drops to an emergency shell at boot.
mkinitcpio-archiso
# BOTH stay, and no boot configuration names either of them any more — which is
# exactly why this comment exists, because the next tidy-up will read them as
# dead weight. They do not ship a boot file that is loaded; they ship
# /usr/lib/firmware/{intel,amd}-ucode/, and that directory is what mkinitcpio's
# `microcode` hook reads to build the early cpio inside initramfs-linux.img.
# Remove them and the hook finds nothing, stays silent about it, and the ISO
# boots every machine with no microcode update. The installed system is a copy
# of this live root and rebuilds its own initramfs from the same firmware, so it
# needs them for the same reason and has no mirror to fetch them from.
intel-ucode
amd-ucode

# ── Bootloaders ──────────────────────────────────────────────────
# syslinux provides the BIOS boot files mkarchiso stages into the image, and is
# also what gamecore-disk-install.sh installs on a legacy-BIOS target.
syslinux
# systemd-boot ships with systemd; efibootmgr is what writes the NVRAM entry.
efibootmgr

# ── Disk tooling — the guided partitioner's toolbox ──────────────
gptfdisk
dosfstools
e2fsprogs
btrfs-progs
parted
# arch-chroot and genfstab. The installer runs arch.sh inside the target, and
# hand-rolling the bind mounts for /proc /sys /dev /run is how you get an
# install that half-worked.
arch-install-scripts

# ── Live session — what draws the installer ──────────────────────
xorg-server
xorg-xinit
xorg-xrandr
# A window manager, and the reason there is one at all: without it the Qt
# wizard has no way to be moved or resized, and its modal dialogs open at
# (0,0) stacked on top of each other. openbox is ~1 MB.
openbox
# The installer runs FROM SOURCE on the ISO, against the distro's own Qt —
# there is no PyInstaller bundle here. That is not laziness: read the header of
# install/installer-gui/gamecore-installer.spec. The bundled binary exists to
# survive being built on Ubuntu and run on Arch, and it carries a hand-written
# library exclusion list to stop libxkbcommon from segfaulting on the first
# keypress. On the ISO the build host and the run host are the same Arch, so
# that entire class of bug cannot happen — and the exclusion list cannot go
# stale on us.
pyside6
python
python-pip

# ── Networking (optional at install time, needed for Flatpaks after) ──
# backend/routers/settings/wifi.py drives Wi-Fi entirely through `nmcli`, and
# install/arch.sh does NOT install networkmanager — it relies on the distro
# having brought it. Manjaro does; a bare Arch does not. An ISO-installed box
# starts from base, so without this line its Settings → Wi-Fi screen is a
# permanent "nmcli: not found".
networkmanager
# NetworkManager's default supplicant. iwd would need NM reconfigured to use it,
# and an unconfigured pair is a Wi-Fi list that is always empty.
wpa_supplicant
wireless-regdb
# mDNS — the box answers to <hostname>.local so the LAN does not need its IP,
# which is a DHCP lease and changes. Unlike networkmanager above, these are also
# in install/arch.sh's PKGS: mDNS is a capability GameCore adds rather than one
# it consumes, and its absence is silent (no error anywhere, the name simply
# never resolves). arch.sh also patches nsswitch.conf, without which nss-mdns
# is installed and never consulted.
avahi
nss-mdns

# ── GameCore's own dependencies — mirrors install/arch.sh PKGS ────
# Kept in the same order as the array in arch.sh so a diff between the two is
# readable by eye.
mesa
git
flatpak
openssh
nodejs
npm
ffmpeg
plasma-desktop
plasma-x11-session
sddm
xorg-xdpyinfo
xorg-xset
unclutter
bluez
bluez-utils
caddy
rsync
cpupower
feh

# ── GPU drivers — all three vendors, on purpose ──────────────────
# The ISO cannot know what card the target machine has, and the install is
# offline, so it carries every stack and arch.sh's detection picks at install
# time. This is most of the reason the image is large; it is also the reason a
# box with an NVIDIA card is not a black screen.
xf86-video-amdgpu
vulkan-radeon
vulkan-intel
vulkan-swrast
nvidia-open
nvidia-utils
dkms
lib32-vulkan-radeon
lib32-vulkan-intel
lib32-nvidia-utils
# lspci — arch.sh's GPU detection is `lspci -nn | grep -Ei 'vga|3d|display'`,
# and with no lspci that grep matches nothing: every ISO install would land in
# the "GPU not identified" branch and install mesa alone.
pciutils

# ── Small tools the install and the live session lean on ─────────
sudo
curl
wget
unzip
# bsdtar — arch.sh's Electron fallback tries it before unzip.
libarchive
less
nano
which
usbutils
