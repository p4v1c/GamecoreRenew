[Unit]
Description=GameCore — let the Bluetooth adapter and pads wake the box from Rest mode
# USB power/wakeup resets at every boot. After udev's coldplug so every device
# is in sysfs; 90-gamecore-wake.rules covers what is plugged in later.
After=systemd-udev-trigger.service bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gamecore-wake-setup
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
