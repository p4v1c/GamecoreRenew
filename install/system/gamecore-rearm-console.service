[Unit]
Description=GameCore — put the console session back after a trip to the desktop
# Before the display manager, and that ordering is the whole unit.
#
# SDDM reads /etc/sddm.conf.d/* once, when it starts, and nothing it does later
# re-reads them. So the only moment a boot can be redirected is before that —
# which is exactly when this runs.
#
# What it undoes: leaving the console writes `Session=<desktop>` so the display
# manager, restarted on the spot, lands the player on their desktop. That write
# is persistent, so every boot after it opened the desktop too. The player asked
# to go to the desktop, not to stop booting the console, and until now the
# interface gave them no way to say the difference.
Before=display-manager.service
After=local-fs.target
ConditionPathExists=/var/lib/gamecore/rearm-console

[Service]
Type=oneshot
RemainAfterExit=no
# `--force` because the check this skips is "is a desktop session installed to
# come back to", which is a question for leaving, not for returning.
ExecStart=/usr/local/bin/gamecore-session-select gamecore --force
# The marker goes whatever happened. A trip that could not be undone is worth
# one line in the journal; a marker that survives its own failure re-arms the
# box on every boot from now on, which is a worse fault than the one it fixes.
ExecStopPost=/usr/bin/rm -f /var/lib/gamecore/rearm-console
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
