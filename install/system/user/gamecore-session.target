[Unit]
# Everything that belongs to a GameCore session, and nothing that outlives it.
#
# Started by `gamecore-session` once the compositor is up and the session's
# environment has been handed to the user manager; stopped by it on the way
# out. That is the whole reason this target exists rather than hanging the UI
# off `graphical-session.target`: with linger enabled — and it is, the gamepad
# bridge and the packs' layout daemons need it at boot — the user manager
# starts before any graphical login, so `graphical-session.target` is not a
# reliable statement about a session that exists.
#
# Units that must survive without a session (the bridge, the layout daemons)
# stay on `default.target` and are deliberately NOT part of this.
Description=GameCore console session
