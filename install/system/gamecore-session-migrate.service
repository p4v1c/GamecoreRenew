[Unit]
Description=GameCore — install the console session (one shot)
# Runs `install/steps/setup-gamecore-session.sh` with the values the installer
# recorded, as root, and exits.
#
# It exists because the updater runs UNPRIVILEGED, and the migration writes to
# /usr/local/bin, /usr/share/xsessions and the systemd of the machine. The
# alternative was a line in an update log telling the owner to run a command
# themselves — which is not a migration, it is a hope.
#
# Nothing about it is parameterised by the caller: the helper reads the values
# from root-owned sources — the installer's manifest, or failing that the
# backend's own unit — and never from whoever started this. The sudoers rule
# that lets the GameCore user start it therefore grants exactly one action with
# no arguments at all — see install/steps/setup-update-permissions.sh.
#
# Two sources rather than one because the manifest is not on every box: an
# installation older than the manifest has none, and depending on it alone cost
# a failed update on the reference machine — after the code had been replaced.
# `gamecore-session-migrate --check` reports which source answers, and the
# updater's preflight calls exactly that.

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/local/bin/gamecore-session-migrate
StandardOutput=journal
StandardError=journal
