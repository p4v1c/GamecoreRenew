#!/usr/bin/env bash
# ================================================================
#  gamecore-addon — GameCore addon manager
#
#  install <name>   clone/pull the addons repo, run the addon's
#                   install.sh, record it in the registry
#  remove  <name>   run uninstall.sh, clean the registry
#  list [--json]    available (repo) vs installed (registry)
#  update [<name>]  git pull + re-run install.sh (default: all installed)
#
#  The repo checkout IS the runtime: services run straight from
#  $GCA_REPO_DIR. The registry ($GAMECORE_DATA/config/addons.json)
#  is written by this tool only — addon scripts never touch it.
#
#  Env overrides (sandbox / ISO):
#    GCA_REPO_URL   addons repo         (default: p4v1c/gamecore-addons)
#    GCA_REPO_DIR   checkout dir        (default: see below)
#    GAMECORE_PATH  core install dir    (default: /opt/GameCore)
#    GAMECORE_DATA  player data dir     (default: $GAMECORE_PATH)
#    OFFLINE=1      never hit the network (repo comes from PAYLOAD_DIR)
#    PAYLOAD_DIR    offline assets dir for the ISO installer
#
#  ── The hook contract, version 1 ────────────────────────────────
#  An addon's install.sh / uninstall.sh is handed GAMECORE_DATA and
#  ADDON_DATA_DIR, and must write to those. GAMECORE_PATH is passed
#  for reading only: it becomes a read-only mount, and an addon that
#  writes under it will fail at install time on a box nobody is
#  watching. addon.json must declare `"api": 1` to say it knows this;
#  one without it is refused by name rather than left to write into a
#  directory that will not accept it.
# ================================================================
set -euo pipefail

GCA_REPO_URL="${GCA_REPO_URL:-https://github.com/p4v1c/gamecore-addons.git}"
GAMECORE_PATH="${GAMECORE_PATH:-/opt/GameCore}"
# Defaults to the install, exactly like the backend's services/paths.py: until
# the data physically moves (P12) the two are the same directory, and nothing
# an addon touches changes location on the release that introduces this.
GAMECORE_DATA="${GAMECORE_DATA:-$GAMECORE_PATH}"
OFFLINE="${OFFLINE:-0}"
PAYLOAD_DIR="${PAYLOAD_DIR:-}"
REGISTRY="${GAMECORE_DATA}/config/addons.json"

# The checkout is git-managed code, but the player installs and removes it at
# runtime — so it cannot live on a read-only root, and it is not shipped by the
# OTA either. It is the fourth category the code/data split did not have a name
# for: mutable code, which belongs on the data side.
#
# An existing /opt/gamecore-addons keeps being used. Every box installed before
# this release has its addons there, with services already pointing into it;
# relocating it from under them would break running addons for no gain, and the
# player would have no way to tell why.
if [[ -z "${GCA_REPO_DIR:-}" ]]; then
  if [[ -d /opt/gamecore-addons/.git || -d /opt/gamecore-addons/addons ]]; then
    GCA_REPO_DIR="/opt/gamecore-addons"
  else
    GCA_REPO_DIR="${GAMECORE_DATA}/addons/_repo"
  fi
fi

# The hook contract this CLI speaks. Bumped only when a guarantee is withdrawn.
GCA_API_VERSION=1

# systemctl --user must work when we are called from a system service
# (the core backend drives this CLI from the Addons screen).
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

die()  { echo "[gamecore-addon] ERROR: $*" >&2; exit 1; }
info() { echo "[gamecore-addon] $*"; }

command -v python3 >/dev/null || die "python3 not found"
command -v git     >/dev/null || die "git not found"

# ── addon.json / registry helpers (python3 — no jq dependency) ───
meta() {  # meta <addon-dir> <key> → value ("" if absent)
  python3 - "$1/addon.json" "$2" <<'PY'
import json, sys
v = json.load(open(sys.argv[1])).get(sys.argv[2], "")
print(v if not isinstance(v, bool) else str(v).lower())
PY
}

registry_add() {  # registry_add <addon-dir>
  python3 - "$1/addon.json" "$REGISTRY" <<'PY'
import json, sys, datetime, os, tempfile
meta = json.load(open(sys.argv[1]))
path = sys.argv[2]
try:
    reg = json.load(open(path))
except (FileNotFoundError, json.JSONDecodeError):
    reg = {}
entry = {k: meta[k] for k in ("label", "description", "version", "type", "service", "path") if k in meta}
if meta.get("type") == "web":
    entry["port"] = meta.get("port")
entry["installed_at"] = datetime.datetime.now().isoformat(timespec="seconds")
reg[meta["name"]] = entry
os.makedirs(os.path.dirname(path), exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(reg, f, indent=2, sort_keys=True)
    f.write("\n")
os.replace(tmp, path)
PY
}

registry_remove() {  # registry_remove <name>
  python3 - "$1" "$REGISTRY" <<'PY'
import json, sys, os, tempfile
name, path = sys.argv[1], sys.argv[2]
try:
    reg = json.load(open(path))
except (FileNotFoundError, json.JSONDecodeError):
    sys.exit(0)
reg.pop(name, None)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(reg, f, indent=2, sort_keys=True)
    f.write("\n")
os.replace(tmp, path)
PY
}

registry_names() {
  python3 - "$REGISTRY" <<'PY'
import json, sys
try:
    print("\n".join(sorted(json.load(open(sys.argv[1])))))
except (FileNotFoundError, json.JSONDecodeError):
    pass
PY
}

# ── repo checkout ────────────────────────────────────────────────
ensure_repo() {  # ensure_repo [pull]
  if [[ ! -d "$GCA_REPO_DIR/.git" ]]; then
    if [[ "$OFFLINE" == "1" ]]; then
      # The payload copy carries no .git — a previous offline install already
      # populated the dir. Without this guard, `cp -r` would nest a second
      # gamecore-addons/ INSIDE the existing checkout on every re-run.
      if [[ -d "$GCA_REPO_DIR/addons" ]]; then
        return
      fi
      [[ -n "$PAYLOAD_DIR" && -d "$PAYLOAD_DIR/gamecore-addons" ]] \
        || die "offline mode: no checkout at $GCA_REPO_DIR and no gamecore-addons/ in PAYLOAD_DIR"
      info "Offline: copying addons repo from payload"
      mkdir -p "$(dirname "$GCA_REPO_DIR")" 2>/dev/null \
        || die "cannot create $(dirname "$GCA_REPO_DIR") (run the core installer first, or sudo mkdir + chown)"
      cp -r "$PAYLOAD_DIR/gamecore-addons" "$GCA_REPO_DIR"
    else
      info "Cloning $GCA_REPO_URL → $GCA_REPO_DIR"
      timeout 300 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 \
          clone -q "$GCA_REPO_URL" "$GCA_REPO_DIR" \
        || { rm -rf "$GCA_REPO_DIR"; die "clone failed — does $(dirname "$GCA_REPO_DIR") exist and belong to you?"; }
    fi
  elif [[ "${1:-}" == "pull" && "$OFFLINE" != "1" ]]; then
    info "Updating addons repo (git pull)"
    git -C "$GCA_REPO_DIR" pull -q --ff-only || die "git pull failed in $GCA_REPO_DIR"
  fi
}

addon_dir() {  # addon_dir <name> — validates the name, echoes the path
  local name="$1"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid addon name '$name'"
  local dir="$GCA_REPO_DIR/addons/$name"
  [[ -f "$dir/addon.json" ]] || die "unknown addon '$name' (no addons/$name/addon.json in $GCA_REPO_DIR)"
  echo "$dir"
}

check_api() {  # check_api <addon-dir> — refuse an addon written before the split
  local dir="$1" name declared
  name="$(basename "$dir")"
  declared="$(meta "$dir" api)"
  if [[ -z "$declared" ]]; then
    die "addon '$name' does not declare an api version in addon.json.

  It was written before GameCore separated code from data, so it may well
  write under \$GAMECORE_PATH — which is becoming a read-only mount. Refusing
  now, by name, rather than letting it install and fail later on a box with
  nobody in front of it.

  To port it: write to \$ADDON_DATA_DIR (or under \$GAMECORE_DATA), never to
  \$GAMECORE_PATH, then add \"api\": $GCA_API_VERSION to its addon.json."
  fi
  if [[ "$declared" != "$GCA_API_VERSION" ]]; then
    die "addon '$name' speaks api $declared, this GameCore speaks $GCA_API_VERSION."
  fi
}

run_script() {  # run_script <addon-dir> <install.sh|uninstall.sh>
  local dir="$1" script="$2"
  [[ -f "$dir/$script" ]] || die "$script missing for addon $(basename "$dir")"
  local scope; scope="$(meta "$dir" service)"
  if [[ "$scope" == "system" && $EUID -ne 0 ]]; then
    die "addon '$(basename "$dir")' installs a system service — run with sudo"
  fi
  # The addon's own writable corner, created before the hook runs so that
  # `install.sh` can simply write into it — an addon should not have to know
  # how GameCore lays out its data to keep a config file.
  local addon_data
  addon_data="${GAMECORE_DATA}/addons/$(basename "$dir")"
  mkdir -p "$addon_data" 2>/dev/null || true
  USER_NAME="${SUDO_USER:-$(id -un)}" \
  GAMECORE_PATH="$GAMECORE_PATH" \
  GAMECORE_DATA="$GAMECORE_DATA" \
  GAMECORE_ADDON_API="$GCA_API_VERSION" \
  ADDON_DATA_DIR="$addon_data" \
  GAMECORE_BACKEND_PORT="${GAMECORE_BACKEND_PORT:-8765}" \
  ADDON_DIR="$dir" \
  OFFLINE="$OFFLINE" \
  PAYLOAD_DIR="$PAYLOAD_DIR" \
    bash "$dir/$script"
}

# ── commands ─────────────────────────────────────────────────────
cmd_install() {
  local name="${1:-}"; [[ -n "$name" ]] || die "usage: gamecore-addon install <name>"
  ensure_repo pull
  local dir; dir="$(addon_dir "$name")"
  check_api "$dir"
  info "Installing '$name' v$(meta "$dir" version)"
  run_script "$dir" install.sh
  registry_add "$dir"
  info "'$name' installed and registered."
}

cmd_remove() {
  local name="${1:-}"; [[ -n "$name" ]] || die "usage: gamecore-addon remove <name>"
  # same validation as addon_dir — remove must never eval an arbitrary path
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid addon name '$name'"
  local dir="$GCA_REPO_DIR/addons/$name"
  if [[ -f "$dir/uninstall.sh" ]]; then
    run_script "$dir" uninstall.sh
  else
    info "WARNING: no checkout/uninstall.sh for '$name' — cleaning the registry only."
  fi
  registry_remove "$name"
  info "'$name' removed."
}

cmd_update() {
  # `git pull` is repo-wide: naming one addon still brings down new code for
  # every one of them, since the addons run straight out of this checkout. If
  # only the named addon's install.sh were replayed, the others would be left
  # running new code with their deploy step (shared files, dependencies,
  # service units) never re-applied — a state nothing else would ever repair.
  # So every registered addon is reinstalled after a pull, whatever was asked
  # for; the request only decides what gets mentioned.
  local requested=("$@")
  ensure_repo pull

  local targets=()
  mapfile -t targets < <(registry_names)
  if [[ ${#requested[@]} -gt 0 && ${#targets[@]} -gt 1 ]]; then
    info "Note: the pull updates the whole addons repo, so every installed addon"
    info "      is reinstalled — not just ${requested[*]}."
  fi
  [[ ${#targets[@]} -gt 0 ]] || targets=("${requested[@]}")
  [[ ${#targets[@]} -gt 0 ]] || { info "No addon installed — nothing to update."; return; }
  for name in "${targets[@]}"; do
    local dir
    if ! dir="$(addon_dir "$name" 2>/dev/null)"; then
      # an installed addon that vanished from the repo must not abort the
      # update of every following addon
      info "WARNING: '$name' is not in the repo anymore — skipped."
      continue
    fi
    check_api "$dir"
    info "Updating '$name' → v$(meta "$dir" version)"
    run_script "$dir" install.sh
    registry_add "$dir"
  done
  info "Update done."
}

cmd_list() {
  # Try to have a checkout for the "available" side, but never fail `list` —
  # subshell required: die() would exit the whole script through `|| true`.
  [[ -d "$GCA_REPO_DIR/.git" ]] || ( ensure_repo ) >/dev/null 2>&1 || true
  python3 - "$GCA_REPO_DIR" "$REGISTRY" "${1:-}" <<'PY'
import json, sys, glob, os
repo_dir, registry, flag = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    installed = json.load(open(registry))
except (FileNotFoundError, json.JSONDecodeError):
    installed = {}
available = []
for f in sorted(glob.glob(os.path.join(repo_dir, "addons", "*", "addon.json"))):
    name = os.path.basename(os.path.dirname(f))
    if name.startswith("_"):
        continue
    try:
        available.append(json.load(open(f)))
    except json.JSONDecodeError:
        print(f"[gamecore-addon] WARNING: bad JSON in {f}", file=sys.stderr)
if flag == "--json":
    print(json.dumps({"available": available, "installed": installed}, indent=2, sort_keys=True))
else:
    if not available and not installed:
        print("No addons repo checkout and nothing installed.")
    for a in available:
        name = a.get("name", "?")
        mark = "✓ installed" if name in installed else "  available"
        extra = f" :{a['port']}" if a.get("type") == "web" and a.get("port") else ""
        if name in installed and installed[name].get("version") != a.get("version"):
            mark += f" (update: {installed[name].get('version')} → {a.get('version')})"
        print(f"{mark}  {name:<16} {a.get('type', '?'):<8}{extra}  {a.get('description', '')}")
    for name in sorted(set(installed) - {a.get("name") for a in available}):
        print(f"✓ installed  {name:<16} {installed[name].get('type', '?'):<8}  (not in repo anymore)")
PY
}

cmd_auth_reset() {
  # Rotates the cookie HMAC secret AND sets a new password hash — every
  # open session dies. The auth code lives in the core venv (argon2).
  local py="$GAMECORE_PATH/.venv/bin/python3"
  [[ -x "$py" ]] || die "core venv not found at $py (is GameCore installed?)"
  local p1 p2
  while true; do
    read -rsp "New web password (cannot be empty): " p1; echo
    [[ -n "$p1" ]] || { echo "Empty password refused." >&2; continue; }
    read -rsp "Confirm                           : " p2; echo
    [[ "$p1" == "$p2" ]] && break
    echo "Passwords differ — try again." >&2
  done
  WEB_PASSWORD="$p1" GAMECORE_PATH="$GAMECORE_PATH" GAMECORE_DATA="$GAMECORE_DATA" "$py" - <<'PY'
import os, sys
sys.path.insert(0, os.environ["GAMECORE_PATH"])
from backend.services import auth
auth.set_password(os.environ["WEB_PASSWORD"], reset_secret=True)
PY
  # auth.py writes both files 0600 with the CURRENT euid. Run under sudo — the
  # natural thing to type for a root-installed CLI — that leaves them root:root,
  # the backend (User=<gamecore user>) then cannot read them, is_configured()
  # reports False, and the box is locked out of its own web UI with no way in.
  if [[ $EUID -eq 0 ]]; then
    owner="$(stat -c '%U:%G' "$GAMECORE_DATA/config" 2>/dev/null)"
    if [[ -n "$owner" && "$owner" != "root:root" ]]; then
      chown "$owner" "$GAMECORE_DATA/config/auth.json" "$GAMECORE_DATA/config/auth_secret" 2>/dev/null \
        && info "Credential files handed back to $owner."
    fi
  fi
  info "Password reset — all web sessions are now invalid."
}

# ── dispatch ─────────────────────────────────────────────────────
case "${1:-}" in
  install)    shift; cmd_install "$@" ;;
  remove)     shift; cmd_remove  "$@" ;;
  update)     shift; cmd_update  "$@" ;;
  list)       shift || true; cmd_list "${1:-}" ;;
  auth-reset) cmd_auth_reset ;;
  *) cat >&2 <<'EOF'
gamecore-addon — GameCore addon manager
Usage:
  gamecore-addon install <name>
  gamecore-addon remove  <name>
  gamecore-addon update  [<name>...]
  gamecore-addon list    [--json]
  gamecore-addon auth-reset      (new web password + kill all sessions)
EOF
     exit 1 ;;
esac
