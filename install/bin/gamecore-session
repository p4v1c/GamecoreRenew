#!/usr/bin/env bash
# ================================================================
#  gamecore-session — the console session itself.
#
#  Run by SDDM as the session command for /usr/share/xsessions/gamecore.desktop.
#  It is what replaces "log into the machine's desktop, then draw the kiosk on
#  top of it": there is no desktop behind GameCore any more, so there is
#  nothing to see before it.
#
#  What it starts, and nothing else:
#    · KWin (X11) as the compositor — the overlays, the fullscreen enforcer and
#      the window monitor are all written against its behaviour;
#    · gamecore-session.target, the user units that belong to this session.
#
#  What it deliberately does NOT start: plasmashell, its panels, its wallpaper,
#  its session restore. Those are the seconds the player was watching.
#
#  X11 on purpose, and stated so it is not mistaken for an oversight: the bezel
#  overlays, the fullscreen enforcer, gamecore-xsetup and the gamepad bridge
#  are X11 code. Wayland is a separate piece of work, not a flag.
# ================================================================
set -u

# Both, and the journal is the one that matters.
#
# `echo` alone goes to SDDM's session log, and on the reference box that file
# is zero bytes — so `journalctl -t gamecore-session` answered "No entries"
# for a session that had started four times. A session that cannot say what it
# did is a session nobody can debug from an SSH prompt.
log() {
  echo "[gamecore-session] $*"
  command -v logger >/dev/null 2>&1 && logger -t gamecore-session -- "$*" || true
}

# ── the session's own identity ───────────────────────────────────
export XDG_SESSION_DESKTOP=gamecore
export XDG_CURRENT_DESKTOP=GameCore
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [[ -z "${DISPLAY:-}" ]]; then
  log "no DISPLAY — this session is started by the display manager, on X11."
  exit 1
fi

# ── hand the environment over, rather than let anything guess it ──
#
# Two consumers, and they cannot be served the same way.
#
# The user manager gets it by import: the units of this session (the UI) and
# the ones that outlive it (the gamepad bridge, the packs' layout daemons) all
# read DISPLAY from there. Without this they inherit whatever the last session
# left, which is how a daemon ends up talking to a display that no longer
# exists.
systemctl --user import-environment \
  DISPLAY XAUTHORITY XDG_SESSION_ID XDG_SESSION_TYPE \
  XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP 2>/dev/null || true

# The backend is a SYSTEM unit — deliberately, so the web interface and the
# API survive without a graphical session — and a system unit cannot see any
# of the above. It used to probe X for itself: a loop over every socket and
# every cookie location, with a twenty-second bound in its unit, running on
# every start whether or not anything needed a display.
#
# So the session writes it down instead, in the user's own runtime directory,
# renewed at every login and removed on the way out. A file that is absent
# means "no session", which is exactly what a headless box should look like.
SESSION_ENV_DIR="$XDG_RUNTIME_DIR/gamecore"
SESSION_ENV="$SESSION_ENV_DIR/session.env"
# Set by the interface when the player picks Settings → Mode bureau, and read
# by the teardown below. See the comment there for why the interface no longer
# performs the switch itself.
LEAVE_MARKER="$SESSION_ENV_DIR/leave-to-desktop"
mkdir -p "$SESSION_ENV_DIR"
chmod 700 "$SESSION_ENV_DIR" 2>/dev/null || true
umask 077
{
  printf 'DISPLAY=%s\n' "$DISPLAY"
  [[ -n "${XAUTHORITY:-}" ]] && printf 'XAUTHORITY=%s\n' "$XAUTHORITY"
  printf 'XDG_SESSION_DESKTOP=%s\n' "$XDG_SESSION_DESKTOP"
  printf 'STARTED=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$SESSION_ENV"
# A marker left by a session that was killed before its teardown ran would
# send the NEXT login straight back to the desktop.
rm -f "$LEAVE_MARKER" 2>/dev/null || true
log "session environment written to $SESSION_ENV (DISPLAY=$DISPLAY)"

# start-ui.sh applies the saved mode with this session’s actual display.

# ── teardown, whatever happens ───────────────────────────────────
cleanup() {
  log "session ending — stopping GameCore units"
  # The compositor goes with the session. Left behind, it holds the X server
  # and the next session finds a screen with somebody else's windows on it.
  if [[ -n "${SUPERVISOR_PID:-}" ]]; then
    pkill -P "$SUPERVISOR_PID" 2>/dev/null || true
    kill "$SUPERVISOR_PID" 2>/dev/null || true
  fi
  systemctl --user stop gamecore-session.target 2>/dev/null || true
  systemctl --user unset-environment \
    DISPLAY XAUTHORITY XDG_SESSION_ID XDG_SESSION_TYPE \
    XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP 2>/dev/null || true
  rm -f "$SESSION_ENV" 2>/dev/null || true

  # ── the player asked for the desktop ───────────────────────────
  #
  # The switch is done HERE, and not by the interface that requested it.
  #
  # The interface used to run `sudo gamecore-session-select desktop` itself and
  # then quit. On the reference box that call reached sudo — the journal has
  # every invocation — and left the auto-login untouched, five times in a row,
  # while the identical command run by hand from a shell, from a systemd user
  # unit, and from the service's own working directory wrote the file every
  # time. What the interface's attempts had in common is where they ran: inside
  # `gamecore-ui.service`, whose cgroup systemd tears down the moment Electron
  # exits — which is the very next thing the interface does.
  #
  # This runs in the session's own process, outside that cgroup, after the
  # units are stopped and with nothing left to race. `--restart-dm` is part of
  # it because writing the drop-in does not apply it: SDDM read its
  # configuration when the daemon started and will otherwise log straight back
  # into the session it already believes in.
  if [[ -e "$LEAVE_MARKER" ]]; then
    rm -f "$LEAVE_MARKER" 2>/dev/null || true
    log "the player asked for the desktop — for this session, not for good"
    local out
    if out=$(sudo -n /usr/local/bin/gamecore-session-select desktop --once --restart-dm 2>&1); then
      while IFS= read -r line; do log "  $line"; done <<< "$out"
    else
      log "the switch failed — this box will open GameCore again:"
      while IFS= read -r line; do log "  $line"; done <<< "$out"
    fi
  fi
}
trap cleanup EXIT INT TERM

# ── the compositor ───────────────────────────────────────────────
#
# Supervised in the background, and never allowed to end the session by itself.
#
# Ending it would return to SDDM, which auto-logs straight back in: a login
# loop, on a television, with no keyboard. So a compositor that will not stay
# up costs the compositor — the interface is fullscreen and still visible, the
# bezels and the window stacking are not — and says so in the journal, which is
# a box someone can still fix.
# KWin first, and openbox as the last resort.
#
# KWin is the target: the bezel overlay asks for the `screen-saver` layer
# precisely because KWin puts a fullscreen emulator above an ordinary
# always-on-top window, and that behaviour is what the overlay code was written
# against.
#
# openbox is not a compositor and is not equivalent — but it IS a window
# manager, and the difference that matters here is between "a window manager
# whose stacking is not the one we tuned for" and "no window manager at all".
# The second is what this box would have got: recent Plasma ships KWin's X11
# binary in a separate `kwin-x11` package, and a machine running Plasma on
# Wayland does not have it. The session would have started GameCore on a bare
# X server — the interface shows, the bezels stack at random and a fullscreen
# emulator answers to nobody.
# The candidates, in order of preference. Overridable so a test can decide what
# this machine appears to have — without it, a test for "no KWin here" would
# have to hide a real binary from PATH, and the one that tried launched the
# developer's actual KWin against a display that does not exist.
WM_CANDIDATES="${GAMECORE_WM_CANDIDATES:-kwin_x11 kwin openbox}"

# ── the window manager's own keyboard, taken away ────────────────
#
# A console is not a desktop with a game on it. Alt+Tab walking to whatever is
# behind the interface, Meta opening a launcher, Alt+F4 closing the kiosk —
# those are the window manager's defaults, and on a television they are the
# player falling out of the console with no way back that a gamepad can reach.
#
# Written into a config directory of the session's own, and handed ONLY to the
# window manager process. Not exported into the session: the interface, the
# gamepad bridge and the packs' layout daemons all read $XDG_CONFIG_HOME for
# their own settings, and moving it under them would lose every one. This is
# the smallest blast radius that still reaches the process doing the grabbing.
#
# The player's own ~/.config is never touched. The same account boots a desktop
# session on this box, and a kiosk that rewrote the desktop's key bindings
# would be a far worse bug than the one being fixed.
WM_CONFIG_HOME="$SESSION_ENV_DIR/wm"

write_wm_config() {
  mkdir -p "$WM_CONFIG_HOME/openbox" || return 1

  # KWin reads these two out of $XDG_CONFIG_HOME. `none,none,` is the documented
  # way to say "this action has no key", as opposed to omitting the line, which
  # leaves the compiled-in default in place.
  {
    echo '[kwin]'
    for action in \
      'Walk Through Windows' 'Walk Through Windows (Reverse)' \
      'Walk Through Windows Alternative' 'Walk Through Windows Alternative (Reverse)' \
      'Walk Through Windows of Current Application' \
      'Walk Through Windows of Current Application (Reverse)' \
      'Window Close' 'Window Operations Menu' 'Window Minimize' 'Window Maximize' \
      'Window Fullscreen' 'Window Quick Tile Left' 'Window Quick Tile Right' \
      'Kill Window' 'Suspend Compositing' 'Show Desktop' \
      'Expose' 'ExposeAll' 'ExposeClass' \
      'Switch to Next Desktop' 'Switch to Previous Desktop' \
      'Switch One Desktop Down' 'Switch One Desktop Up' \
      'Switch One Desktop to the Left' 'Switch One Desktop to the Right'
    do
      printf '%s=none,none,\n' "$action"
    done
  } > "$WM_CONFIG_HOME/kglobalshortcutsrc"

  {
    # Meta on its own opens Plasma's launcher. There is no Plasma here, but the
    # binding is KWin's and it is spelled out rather than left to chance.
    echo '[ModifierOnlyShortcuts]'
    echo 'Meta='
    echo
    echo '[Windows]'
    # No focus stealing prevention games, and no window switching by mouse
    # wheel on the desktop — there is no desktop.
    echo 'RollOverDesktops=false'
  } > "$WM_CONFIG_HOME/kwinrc"

  # openbox keeps its bindings in its own file, and an empty <keyboard> is a
  # window manager with no keyboard at all. It is passed by path below, so this
  # works whatever openbox would otherwise have read.
  cat > "$WM_CONFIG_HOME/openbox/rc.xml" <<'RC'
<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <!-- A console session: the window manager has no key bindings, because every
       one of them is a way out of the interface that a gamepad cannot undo. -->
  <keyboard></keyboard>
  <mouse></mouse>
</openbox_config>
RC
}

if write_wm_config; then
  log "window manager key bindings disabled for this session ($WM_CONFIG_HOME)"
else
  log "WARNING: could not write the window manager config — Alt+Tab may leave the console."
fi

COMPOSITOR="${GAMECORE_COMPOSITOR:-}"
COMPOSITOR_KIND="compositor"
if [[ -z "$COMPOSITOR" ]]; then
  for candidate in $WM_CANDIDATES; do
    if command -v "$candidate" >/dev/null 2>&1; then COMPOSITOR="$candidate"; break; fi
  done
fi
if [[ "$COMPOSITOR" == openbox || "$COMPOSITOR" == *"/openbox" ]]; then
  COMPOSITOR_KIND="window manager"
  log "no KWin for X11 on this machine — falling back to openbox."
  log "  the interface and the games are fine; the bezels are tuned for KWin."
  log "  for the intended behaviour:  sudo pacman -S kwin-x11"
fi

# Set by the supervisor when the compositor exits cleanly, which is the only
# compositor exit that means "the player is leaving".
COMPOSITOR_LEFT="$SESSION_ENV_DIR/compositor-left"
rm -f "$COMPOSITOR_LEFT" 2>/dev/null || true

# The window manager, started with the locked configuration and nothing else
# changed. `env` rather than an export, so $XDG_CONFIG_HOME is redirected for
# this process alone — see write_wm_config for why that matters.
start_wm() {
  if [[ "$COMPOSITOR_KIND" == "window manager" ]]; then
    # openbox takes the file by path, which is the only way to be sure it is
    # the one being read.
    env XDG_CONFIG_HOME="$WM_CONFIG_HOME" \
      "$COMPOSITOR" --config-file "$WM_CONFIG_HOME/openbox/rc.xml" &
  else
    env XDG_CONFIG_HOME="$WM_CONFIG_HOME" "$COMPOSITOR" &
  fi
}

supervise_compositor() {
  local restarts=0 window_start=$SECONDS status
  while :; do
    log "starting $COMPOSITOR_KIND: $COMPOSITOR"
    start_wm
    wait $! ; status=$?
    if [[ $status -eq 0 ]]; then
      log "$COMPOSITOR_KIND exited cleanly"
      : > "$COMPOSITOR_LEFT"
      return 0
    fi
    (( SECONDS - window_start > 60 )) && { restarts=0; window_start=$SECONDS; }
    restarts=$(( restarts + 1 ))
    if (( restarts > 3 )); then
      log "$COMPOSITOR_KIND failed $restarts times in a minute (last status $status)."
      log "  carrying on without one: the interface stays up, the bezels do not."
      return 1
    fi
    log "$COMPOSITOR_KIND died (status $status) — restart $restarts of 3"
    sleep 1
  done
}

if [[ -z "$COMPOSITOR" ]]; then
  log "no window manager on this machine — running without one."
  log "  the interface will show; bezels and window stacking will not."
  log "  install one:  sudo pacman -S kwin-x11"
  SUPERVISOR_PID=""
else
  supervise_compositor &
  SUPERVISOR_PID=$!
fi

# ── the session's own units ──────────────────────────────────────
if ! systemctl --user start gamecore-session.target; then
  log "gamecore-session.target refused to start."
  log "  see: journalctl --user -u gamecore-ui.service"
fi

# ── what keeps the session alive ─────────────────────────────────
#
# Two things can end it, and both have to be watched: the player leaving
# (Settings → Desktop quits the interface) and the compositor exiting cleanly.
# Neither is a timer — the poll below is supervision, not a countdown, and it
# decides nothing except when this script has nothing left to wait for.
log "session up"
while :; do
  [[ -e "$COMPOSITOR_LEFT" ]] && { log "the compositor was closed — ending the session"; break; }
  if [[ -n "$SUPERVISOR_PID" ]] && ! kill -0 "$SUPERVISOR_PID" 2>/dev/null; then
    # The supervisor gave up (a compositor that will not stay up). The session
    # continues without one; the interface is what the player came for.
    SUPERVISOR_PID=""
  fi
  if ! systemctl --user is-active --quiet gamecore-ui.service; then
    # Also true for the seconds between two restarts, so it is confirmed once
    # rather than acted on immediately.
    sleep 3
    if ! systemctl --user is-active --quiet gamecore-ui.service; then
      log "the interface is no longer running — ending the session"
      break
    fi
  fi
  sleep 2
done
