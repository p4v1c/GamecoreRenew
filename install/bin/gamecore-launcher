#!/usr/bin/env bash
# GameCore — desktop launcher, behind the desktop's "GameCore" icon
# (install/arch.sh writes it with no argument).
#
#   gamecore-launcher                  back to the console session (the icon)
#   gamecore-launcher --over-desktop   draw GameCore over this desktop (dev)
#
# The icon used to draw the interface over the desktop. Games then failed to
# launch and Alt+Tab left the UI: only the console session runs GameCore.
# --session is still accepted, older shortcuts pass it.
#
# Over the desktop is NOT the console: the desktop's window manager still owns
# Alt+Tab and Meta, which walk the player onto a desktop a pad cannot drive.
set -u

MODE=session
case "${1:-}" in
  --over-desktop) MODE=over-desktop ;;
  --session|"") ;;
  *) echo "usage: $(basename "$0") [--over-desktop]" >&2; exit 2 ;;
esac

SELECT=/usr/local/bin/gamecore-session-select

# ── session: arm the console and hand the screen to it ─────────────────────
#
# First, and on its own. Starting the interface over this desktop and *then*
# restarting the display manager would draw a kiosk for the second before
# killing the session it was drawn on.
if [[ "$MODE" == session && ! -x "$SELECT" ]]; then
  # A box set up before the console session still gets its interface.
  echo "ℹ️  $SELECT is missing — no console session here, drawing over the desktop."
  MODE=over-desktop
fi
if [[ "$MODE" == session ]]; then
  echo "Arming the console session and applying it now…"
  echo "  (this ends the desktop session — the box comes back up in GameCore)"
  if sudo -n "$SELECT" gamecore --restart-dm; then
    echo "✅ Done."
    exit 0
  fi
  echo "❌ Could not arm it. Run by hand:  sudo $SELECT gamecore --restart-dm"
  sleep 10  # the icon opens a terminal; leave the error readable
  exit 1
fi

# The backend is a system unit and stays one — the API and the web interface
# are useful without a graphical session.
if systemctl is-active --quiet gamecore-backend.service; then
  echo "🟢 gamecore-backend.service is already running."
else
  echo "🔴 gamecore-backend.service is stopped. Starting..."
  sudo -n systemctl start gamecore-backend.service 2>/dev/null \
    && echo "✅ gamecore-backend.service started." \
    || echo "❌ Could not start gamecore-backend.service."
fi

# The interface is a USER unit now, and this is the desktop escape hatch: from
# a desktop session, starting it draws GameCore over that desktop exactly as
# the old system-wide unit did. No sudo — it is this user's own manager.
#
# The system unit is tried second and only if the user one is not installed:
# a box that has not been migrated still has it, and the point of this script
# is to work on both.
if systemctl is-active --quiet gamecore-ui.service 2>/dev/null; then
  echo "🟢 The legacy kiosk is already running."
elif systemctl --user is-active --quiet gamecore-ui.service 2>/dev/null; then
  echo "🟢 GameCore is already running."
elif systemctl --user list-unit-files gamecore-ui.service >/dev/null 2>&1 \
     && systemctl --user cat gamecore-ui.service >/dev/null 2>&1; then
  echo "🔴 GameCore is stopped. Starting..."
  systemctl --user start gamecore-ui.service \
    && echo "✅ GameCore started." \
    || echo "❌ Could not start GameCore — see: journalctl --user -u gamecore-ui"
else
  echo "🔴 GameCore is stopped (this box has not been migrated). Starting..."
  sudo -n systemctl start gamecore-ui.service 2>/dev/null \
    && echo "✅ GameCore started." \
    || echo "❌ Could not start GameCore."
fi

# ── which session this box actually boots ────────────────────────────────────
#
# Reported every time, because "GameCore will not start" and "GameCore starts
# but you can Alt+Tab out of it" are the same box in the same state, and
# nothing said so. `status` needs no root.
if [[ -x "$SELECT" ]]; then
  mode_line=$("$SELECT" status 2>/dev/null | sed -n 's/^mode  *: //p')
  case "$mode_line" in
    gamecore*)
      echo "🟢 Console session armed — this box boots into GameCore."
      ;;
    desktop*)
      echo
      echo "⚠️  This box boots to the DESKTOP, not the console session."
      echo "   What you have now is GameCore drawn over that desktop, which is"
      echo "   why Alt+Tab and the Meta key still leave it: they belong to the"
      echo "   desktop's window manager, not to the console."
      echo
      echo "   To boot into the real console session:"
      echo "     $(basename "$0")"
      ;;
    *)
      echo "ℹ️  Could not read which session this box boots — try: sudo $SELECT status"
      ;;
  esac
fi

# Leave the window open a moment so the result is readable when clicked.
sleep 3
