#!/usr/bin/env bash
# ================================================================
#  gamecore-wake-setup — let the Bluetooth adapter and USB pads wake the
#  box from Rest mode.
#
#  The kernel only lets a USB device wake the machine when its
#  power/wakeup says "enabled", and that resets at every boot and every
#  replug. Run as root by gamecore-wake.service at boot, and by
#  90-gamecore-wake.rules for a pad or adapter plugged in later.
#  Idempotent: an attribute already enabled is not written.
#
#  Which devices:
#    · every Bluetooth adapter's USB device (/sys/class/bluetooth/hci*);
#    · the USB device under every input node GameCore counts as a pad:
#      declares BTN_SOUTH and is not a keyboard (keys 1..31 all declared).
#      Same rule as backend/services/gamepad_devices.py; a test runs both.
#  Keyboards and mice are never touched.
#
#  Usage:
#    gamecore-wake-setup                 every adapter and pad present
#    gamecore-wake-setup --device PATH   one sysfs device (from udev)
#  GAMECORE_SYSFS points it at another sysfs tree (tests).
# ================================================================
set -euo pipefail

SYSFS="$(readlink -f "${GAMECORE_SYSFS:-/sys}")"
BTN_SOUTH=304
WORD_BITS="$(getconf LONG_BIT 2>/dev/null || echo 64)"

log() { echo "[wake] $*"; }

# Bit $2 of an evdev capability bitmap ("7fff0000 0 ..", most significant word first).
has_bit() {
  local -a words
  read -r -a words <<<"$1"
  local idx=$(( ${#words[@]} - 1 - $2 / WORD_BITS ))
  (( idx >= 0 )) || return 1
  (( ((16#${words[idx]} >> ($2 % WORD_BITS)) & 1) == 1 ))
}

# GameCore's pad rule, on an input device directory.
is_gamepad() {
  local keys low
  keys="$(cat "$1/capabilities/key" 2>/dev/null)" || return 1
  [[ -n "$keys" ]] || return 1
  has_bit "$keys" "$BTN_SOUTH" || return 1
  low="${keys##* }"
  # KEY_ESC..KEY_S, bits 1-31 of the lowest word: a keyboard, real or virtual.
  (( (16#$low & 0xfffffffe) != 0xfffffffe ))
}

# The nearest USB device (has idVendor and power/wakeup) at or above $1.
usb_device_of() {
  local dir
  dir="$(readlink -f "$1")" || return 1
  while [[ "$dir" == "$SYSFS"/devices/* ]]; do
    if [[ -f "$dir/idVendor" && -f "$dir/power/wakeup" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="${dir%/*}"
  done
  return 1
}

enable_wakeup() {
  local dev="$1" what="$2" cur id
  cur="$(cat "$dev/power/wakeup" 2>/dev/null)" || return 0
  [[ "$cur" == "enabled" ]] && return 0
  id="$(cat "$dev/idVendor" 2>/dev/null):$(cat "$dev/idProduct" 2>/dev/null)"
  if echo enabled 2>/dev/null > "$dev/power/wakeup"; then
    log "wake enabled on ${dev##*/} ($id, $what)"
  else
    log "could not enable wake on ${dev##*/} ($id, $what)"
  fi
}

setup_adapter() {
  local usb
  usb="$(usb_device_of "$1")" || { log "${1##*/} is not on USB, left alone"; return 0; }
  enable_wakeup "$usb" "bluetooth adapter"
}

setup_input() {
  local usb
  is_gamepad "$1" || return 0
  usb="$(usb_device_of "$1")" || return 0
  enable_wakeup "$usb" "gamepad"
}

setup_device() {
  local real
  real="$(readlink -f "$1")" || return 0
  case "$real" in
    */bluetooth/hci[0-9]*) setup_adapter "$real" ;;
    */input/input[0-9]*)   setup_input "$real" ;;
  esac
}

if [[ "${1:-}" == "--device" ]]; then
  setup_device "${2:?usage: $0 --device <sysfs path>}"
  exit 0
fi

shopt -s nullglob
for hci in "$SYSFS"/class/bluetooth/hci*; do
  [[ "${hci##*/}" == *:* ]] && continue      # a connection, not an adapter
  setup_adapter "$hci"
done
for input in "$SYSFS"/class/input/input*; do
  setup_input "$input"
done
