#!/usr/bin/env bash
# ================================================================
#  gamecore-session-migrate — run the console-session step as root,
#  with arguments nobody outside root can choose.
#
#  Started by `gamecore-session-migrate.service`, which the updater is allowed
#  to start through one narrow sudoers rule. The rule grants one unit and no
#  parameters, so where the values come from is the whole security argument:
#  they are read from root-owned sources here, never passed in.
#
#  Two sources, in order:
#
#    1. /var/lib/gamecore/manifest.env — what the installer recorded.
#    2. the backend's own systemd unit — GAMECORE_PATH, GAMECORE_DATA, the port
#       and User=, all of it root-owned and present on every box that runs.
#
#  The second one exists because the first is NOT present on every box, and
#  finding that out cost a failed update on the reference machine: it was
#  installed before the manifest existed, `source` failed under `set -e`, the
#  unit died, and the OTA aborted after the code had already been replaced.
#  A migration that depends on one file is a migration that a box installed
#  eighteen months ago cannot run.
#
#  `--check` resolves and reports without doing anything. `update/check-session-
#  prerequisites.sh` calls exactly that, so the preflight and the real run can
#  never disagree about whether this box can be migrated.
# ================================================================
set -euo pipefail

CHECK=false
[[ "${1:-}" == "--check" ]] && CHECK=true

MANIFEST="${GAMECORE_MANIFEST:-/var/lib/gamecore/manifest.env}"
UNIT="${GAMECORE_BACKEND_UNIT:-gamecore-backend.service}"

USER_NAME=""; GAMECORE_PATH=""; GAMECORE_DATA=""; WEB_PORT=""
SOURCE=""

# ── 1. the installer's own record ────────────────────────────────
if [[ -r "$MANIFEST" ]]; then
  # In a subshell: the manifest is a KEY=value file written by the installer,
  # and sourcing it here would let a stray line redefine anything above it.
  # shellcheck disable=SC1090
  eval "$(
    set -euo pipefail
    # shellcheck disable=SC1090
    source "$MANIFEST"
    printf 'USER_NAME=%q\nGAMECORE_PATH=%q\nGAMECORE_DATA=%q\nWEB_PORT=%q\n' \
      "${USER_NAME:-}" "${GAMECORE_PATH:-}" "${GAMECORE_DATA:-}" "${WEB_PORT:-}"
  )" || true
  [[ -n "$GAMECORE_PATH" && -n "$USER_NAME" ]] && SOURCE="$MANIFEST"
fi

# ── 2. the running installation itself ───────────────────────────
if [[ -z "$SOURCE" ]] && command -v systemctl >/dev/null 2>&1; then
  unit_env="$(systemctl show "$UNIT" -p Environment --value 2>/dev/null || true)"
  unit_user="$(systemctl show "$UNIT" -p User --value 2>/dev/null || true)"
  for kv in $unit_env; do
    case "$kv" in
      GAMECORE_PATH=*)         [[ -n "$GAMECORE_PATH" ]] || GAMECORE_PATH="${kv#*=}" ;;
      GAMECORE_DATA=*)         [[ -n "$GAMECORE_DATA" ]] || GAMECORE_DATA="${kv#*=}" ;;
      GAMECORE_BACKEND_PORT=*) [[ -n "$WEB_PORT" ]]      || WEB_PORT="${kv#*=}" ;;
    esac
  done
  [[ -n "$USER_NAME" ]] || USER_NAME="$unit_user"
  [[ -n "$GAMECORE_PATH" && -n "$USER_NAME" ]] && SOURCE="$UNIT"
fi

GAMECORE_DATA="${GAMECORE_DATA:-$GAMECORE_PATH}"
WEB_PORT="${WEB_PORT:-8765}"

STEP="$GAMECORE_PATH/install/steps/setup-gamecore-session.sh"

if [[ -z "$SOURCE" ]]; then
  echo "[migrate] ERROR: cannot tell where this installation is." >&2
  echo "[migrate]   tried: $MANIFEST, then the $UNIT unit." >&2
  echo "[migrate]   run the step by hand, once:" >&2
  echo "[migrate]     sudo bash <install>/install/steps/setup-gamecore-session.sh \\" >&2
  echo "[migrate]          <user> <install-path> <data-path> <port>" >&2
  exit 1
fi

if [[ ! -f "$STEP" ]]; then
  echo "[migrate] ERROR: $STEP is not there — is $GAMECORE_PATH the installation?" >&2
  exit 1
fi

if $CHECK; then
  echo "[migrate] would migrate using $SOURCE:"
  echo "[migrate]   user=$USER_NAME path=$GAMECORE_PATH data=$GAMECORE_DATA port=$WEB_PORT"
  exit 0
fi

echo "[migrate] using $SOURCE"
exec /bin/bash "$STEP" "$USER_NAME" "$GAMECORE_PATH" "$GAMECORE_DATA" "$WEB_PORT"
