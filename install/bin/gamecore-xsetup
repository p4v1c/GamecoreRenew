#!/bin/sh
exec python3 - "$@" <<'PY'
"""Apply the confirmed X11 mode once the UI's graphical session exists.

An old SDDM DisplayCommand calls this without arguments: leave its greeter
alone. start-ui.sh is the sole caller that opts in with --session.
"""
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import time


def run(*args):
    return subprocess.run(args, capture_output=True, text=True, timeout=10)


def main():
    if sys.argv[1:] != ["--session"]:
        return 0
    root = Path(os.environ.get("GAMECORE_DATA") or os.environ.get("GAMECORE_PATH", "/opt/GameCore"))
    wanted = {"width": 1920, "height": 1080, "output": ""}
    try:
        pref = json.loads((root / "config/display.json").read_text())
        width, height, rate = int(pref["width"]), int(pref["height"]), float(pref["rate"])
        if width > 0 and height > 0 and math.isfinite(rate) and rate > 0:
            wanted = dict(width=width, height=height, rate=rate, output=str(pref.get("output", "")))
    except (OSError, ValueError, TypeError, KeyError):
        pass

    # A headless backend does not apply modes. The graphical caller waits for
    # an actual connected output; elapsed time never substitutes for one.
    while True:
        try:
            query = run("xrandr", "--query")
        except FileNotFoundError:
            return 0
        except subprocess.TimeoutExpired:
            time.sleep(1)
            continue
        outputs = {}
        output = None
        for line in query.stdout.splitlines():
            match = re.match(r"^(\S+) connected\b", line)
            if match:
                output = match[1]
                outputs[output] = []
            elif line and not line[0].isspace():
                output = None
            elif output:
                outputs[output].append(line)
        if query.returncode == 0 and outputs:
            break
        time.sleep(1)

    output = wanted["output"] if wanted["output"] in outputs else next(iter(outputs))
    mode = f"{wanted['width']}x{wanted['height']}"
    for line in outputs[output]:
        fields = line.split()
        if not fields or fields[0] != mode:
            continue
        current = next((f.rstrip("*+") for f in fields[1:] if "*" in f), None)
        if current and ("rate" not in wanted or abs(float(current) - wanted["rate"]) < .01):
            return 0
    args = ["xrandr", "--output", output, "--mode", mode]
    if "rate" in wanted:
        args += ["--rate", str(wanted["rate"])]
    try:
        result = run(*args)
        if result.returncode:
            print(f"[display] keeping the current mode: {result.stderr.strip()}", file=sys.stderr)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"[display] mode could not be applied: {exc}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
PY
