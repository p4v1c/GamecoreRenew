#!/usr/bin/env bash
# ================================================================
#  gamecore-session-select — turn the GameCore kiosk on or off
#
#      sudo gamecore-session-select desktop     # kiosk off — plain desktop
#      sudo gamecore-session-select desktop --restart-dm   # …and apply it now
#      sudo gamecore-session-select gamecore    # kiosk back on
#      gamecore-session-select status           # what is set right now (no root)
#      gamecore-session-select pick-desktop --x11   # used by install/arch.sh
#
#  Installation preserves the legacy kiosk. Selecting either session retires
#  its automatic startup; the console is armed only by the gamecore command.
# ================================================================
set -euo pipefail

UNIT=gamecore-ui.service

# Overridable so this can be exercised against a staging tree instead of the
# machine running the test. Defaults are the real locations.
SDDM_CONF_DIR="${SDDM_CONF_DIR:-/etc/sddm.conf.d}"
# Where the session the box was using BEFORE the console was armed is written
# down. Not in /etc/sddm.conf.d: SDDM parses every file in that directory
# whatever its extension, so a note left there is configuration.
STATE_DIR="${GAMECORE_STATE_DIR:-/var/lib/gamecore}"
XSESSIONS_DIR="${XSESSIONS_DIR:-/usr/share/xsessions}"
WAYLAND_SESSIONS_DIR="${WAYLAND_SESSIONS_DIR:-/usr/share/wayland-sessions}"

# Every session this machine offers, EXCEPT our own. "<name>\t<dir>".
#
# Excluding `gamecore` is what makes "back to the desktop" mean something on a
# box that has only ever had the console session: the ranking below falls back
# to "anything at all before nothing", and without this the answer to "which
# desktop should I return to" was GameCore itself — the switch reported success
# and changed nothing.
_sessions() {
  local d f n
  for d in "$XSESSIONS_DIR" "$WAYLAND_SESSIONS_DIR"; do
    [[ -d "$d" ]] || continue
    for f in "$d"/*.desktop; do
      [[ -e "$f" ]] || continue
      n=$(basename "$f" .desktop)
      [[ "$n" == gamecore ]] && continue
      printf '%s\t%s\n' "$n" "$d"
    done
  done
}

# Which session the box should auto-log into. Hard-coding "plasma" broke the
# moment the box was not a Plasma box, and a session name that does not exist
# makes SDDM fall back to its own default with no message at all.
#
# X11 first: the whole GameCore stack is X11 (bezel overlays, the fullscreen
# enforcer, gamecore-xsetup's 1080p pin, the gamepad bridge's window detection),
# so --x11 is what install/arch.sh asks for. Full desktops before bare window
# managers, and anything at all before nothing.
PREFERRED=(plasmax11 plasma plasma-x11 gnome-xorg gnome xfce mate cinnamon
           lxqt lxde budgie deepin pantheon i3 sway)

_pick() {   # _pick [--x11]
  local only_x11=false; [[ "${1:-}" == "--x11" ]] && only_x11=true
  local want name dir
  for want in "${PREFERRED[@]}"; do
    while IFS=$'\t' read -r name dir; do
      $only_x11 && [[ "$dir" != */xsessions ]] && continue
      [[ "$name" == "$want" ]] && { printf '%s' "$name"; return 0; }
    done < <(_sessions)
  done
  while IFS=$'\t' read -r name dir; do
    $only_x11 && [[ "$dir" != */xsessions ]] && continue
    printf '%s' "$name"; return 0
  done < <(_sessions)
  return 1
}

_autologin() {
  local s="" v
  # SDDM reads /etc/sddm.conf.d/* in name order and the LAST [Autologin] wins.
  for f in "$SDDM_CONF_DIR"/*.conf; do
    [[ -e "$f" ]] || continue
    v=$(sed -n 's/^Session=//p' "$f" | tail -1)
    [[ -n "$v" ]] && s="$v"
  done
  printf '%s' "${s:-<none>}"
}

case "${1:-}" in
  status)
    if [[ "$(_autologin)" == gamecore ]]; then
      echo "mode          : gamecore (the console session — no desktop behind it)"
    else
      echo "mode          : desktop (auto-login opens '$(_autologin)')"
    fi
    echo "session entry : $([[ -f "$XSESSIONS_DIR/gamecore.desktop" ]] && echo present || echo 'ABSENT — this box has not been migrated')"
    echo "old system ui : $(systemctl is-enabled "$UNIT" 2>/dev/null | head -1 || true)$([[ -n "$(systemctl is-enabled "$UNIT" 2>/dev/null)" ]] || echo absent)"
    echo "auto-login    : $(_autologin)"
    echo "sessions      :"
    _sessions | while IFS=$'\t' read -r n d; do
      printf '  %-18s %s\n' "$n" "${d##*/}"
    done
    exit 0
    ;;
  pick-desktop)
    # Prints the session name and nothing else. install/arch.sh uses it to pick
    # the auto-login session, so the ranking above has ONE implementation rather
    # than a copy in the installer that drifts from this one.
    _pick "${2:-}" || exit 1
    echo
    exit 0
    ;;
  gamecore|kiosk) MODE=gamecore ;;
  desktop)        MODE=desktop  ;;
  *)
    echo "usage: $(basename "$0") gamecore|desktop|status|pick-desktop [--x11]" >&2
    echo "       gamecore [--force]   desktop [--restart-dm]" >&2
    exit 2
    ;;
esac

# Flags, read from everything after the mode rather than from $2 alone: sudoers
# matches a command line exactly, so `desktop --restart-dm` is its own granted
# command and the position of the word has to be part of nothing.
FORCE=false
RESTART_DM=false
for arg in "${@:2}"; do
  case "$arg" in
    --force)      FORCE=true ;;
    --restart-dm) RESTART_DM=true ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

# Root, unless the caller has pointed the paths somewhere it owns.
if [[ $EUID -ne 0 && "$SDDM_CONF_DIR" == /etc/sddm.conf.d ]]; then
  echo "run this with sudo" >&2; exit 1
fi

# ── which session SDDM should open ───────────────────────────────
#
# This used to touch no SDDM configuration at all, and it was right not to:
# there was one session, the machine's own desktop, and the only difference
# between the two modes was whether the kiosk unit was enabled on top of it.
#
# There are two sessions now. `gamecore.desktop` starts a compositor and
# GameCore and nothing else, so "desktop mode" can no longer mean "the same
# session without the kiosk" — the desktop has to be asked for by name, and
# picked the same way the installer picks it, which is what `_pick` is for.
#
# The file name is load-bearing: SDDM reads /etc/sddm.conf.d/* in name order
# and the LAST [Autologin] wins. Manjaro's own kde_settings.conf carries one,
# and 'k' sorts after 'a' — hence 'zz-'.
_write_autologin() {   # _write_autologin <session-name> <user>
  install -d -m 755 "$SDDM_CONF_DIR"
  local conf="$SDDM_CONF_DIR/zz-gamecore-autologin.conf"

  # The backup goes OUTSIDE the directory, and this is not tidiness.
  #
  # SDDM parses every file in /etc/sddm.conf.d/ whatever its extension, so a
  # copy left beside the original is a second [Autologin] — and
  # `…autologin.conf.pre-session` sorts AFTER `…autologin.conf`, so the backup
  # beat the very file it was backing up. Measured on the reference box: armed
  # at 01:44, and the session that started was the one the backup named.
  #
  # The same trap is documented in install/arch.sh for the KDE backup, which is
  # why that one already lives with the manifest.
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  if [[ -f "$conf" && ! -e "$STATE_DIR/autologin.pre-session" ]]; then
    cp -a "$conf" "$STATE_DIR/autologin.pre-session" 2>/dev/null || true
  fi
  # And take out any copy an older version left in there.
  rm -f "$conf.pre-session" 2>/dev/null || true

  cat > "$conf.tmp" <<CONF
[Autologin]
User=$2
Session=$1
Relogin=true
CONF
  mv "$conf.tmp" "$conf"
}

# Files we named, carrying an [Autologin] that is not ours.
#
# `zz-gamecore-openbox.conf` was on the reference box from an older experiment,
# sorted after `zz-gamecore-autologin.conf`, and quietly won every arming. A
# leftover that bears our own prefix is ours to retire; anything else in that
# directory belongs to the operator or the distribution and is left alone —
# but it is REPORTED, because a competing [Autologin] we cannot touch is the
# difference between "armed" and "armed and ignored".
_retire_our_leftovers() {
  local f base
  mkdir -p "$STATE_DIR/retired-sddm" 2>/dev/null || true
  for f in "$SDDM_CONF_DIR"/zz-gamecore-*; do
    [[ -e "$f" ]] || continue
    base=$(basename "$f")
    [[ "$base" == zz-gamecore-autologin.conf ]] && continue
    grep -q '^\[Autologin\]' "$f" 2>/dev/null || continue
    mv -f "$f" "$STATE_DIR/retired-sddm/$base" 2>/dev/null \
      && echo "retired a stale GameCore file that overrode the auto-login: $base"
  done
}

# What SDDM will actually do — the LAST [Autologin] block in name order, which
# is not necessarily the one we just wrote.
#
# Checked rather than assumed: writing a file and announcing success without
# looking at what wins is how an arming reports "console session ON" and the
# box boots the desktop anyway. That happened, twice, before this existed.
_effective_session() {
  local f last=""
  for f in "$SDDM_CONF_DIR"/*; do
    [[ -f "$f" ]] || continue
    grep -q '^\[Autologin\]' "$f" 2>/dev/null || continue
    local v
    v=$(sed -n 's/^Session=//p' "$f" | tail -1)
    [[ -n "$v" ]] && last="$v|$(basename "$f")"
  done
  printf '%s' "$last"
}

_verify_autologin() {   # _verify_autologin <wanted>
  local got file
  got="$(_effective_session)"
  file="${got#*|}"; got="${got%%|*}"
  if [[ "$got" == "$1" ]]; then
    return 0
  fi
  echo >&2
  echo "WARNING: the auto-login this box will actually use is '$got', not '$1'." >&2
  echo "  it comes from: $SDDM_CONF_DIR/$file" >&2
  echo "  SDDM reads every file in that directory and the LAST [Autologin] wins." >&2
  echo "  move that file out of the directory, then run this command again." >&2
  return 1
}

_autologin_user() {
  local u="" v
  for f in "$SDDM_CONF_DIR"/*.conf; do
    [[ -e "$f" ]] || continue
    v=$(sed -n 's/^User=//p' "$f" | tail -1)
    [[ -n "$v" ]] && u="$v"
  done
  printf '%s' "$u"
}

# The desktop to come back to, remembered at the moment the console is armed.
#
# Guessing it does not work, and this box is why: its Plasma is a WAYLAND
# session, so the only X11 desktop `_pick --x11` can find is openbox. Leaving
# the console session would have handed back somebody else's desktop — a
# working one, but not theirs, at one in the morning, reading as a fault.
#
# "Give me my desktop back" is not "give me a desktop that could host the
# kiosk". The second question was the installer's, and it is the wrong one here.
_remember_previous() {   # _remember_previous <session-name>
  local previous="$1"
  [[ -n "$previous" && "$previous" != gamecore && "$previous" != "<none>" ]] || return 0
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  printf '%s\n' "$previous" > "$STATE_DIR/previous-session" 2>/dev/null || true
}

_previous_session() {
  local recorded
  recorded=$(cat "$STATE_DIR/previous-session" 2>/dev/null || true)
  [[ -n "$recorded" ]] || return 1
  # Only if it is still installed: a desktop uninstalled since the arming is a
  # Session= that makes SDDM fall back to its own default, silently.
  while IFS=$'\t' read -r name _dir; do
    [[ "$name" == "$recorded" ]] && { printf '%s' "$recorded"; return 0; }
  done < <(_sessions)
  return 1
}

GC_USER="${GAMECORE_USER:-$(_autologin_user)}"
GC_USER="${GC_USER:-${SUDO_USER:-}}"
[[ -n "$GC_USER" ]] || { echo "cannot tell which user auto-logs in — set GAMECORE_USER" >&2; exit 1; }

# Each switch keeps its own snapshot: later switches must not overwrite the
# state needed to undo the previous one.
backup_switch() {
  local home="${GAMECORE_USER_HOME:-$(getent passwd "$GC_USER" | cut -d: -f6)}" dest saved
  [[ -n "$home" ]] || { echo "cannot find the player's home" >&2; return 1; }
  if [[ ! -d "$home/verif-avant" ]]; then
    if [[ "$SDDM_CONF_DIR" == /etc/sddm.conf.d ]]; then
      install -d -o "$GC_USER" -g "$GC_USER" -m 755 "$home/verif-avant"
    else
      mkdir -p "$home/verif-avant"
    fi
  fi
  SWITCH_BACKUP=$(mktemp -d "$home/verif-avant/gamecore-session-switch.XXXXXXXX")
  printf '#!/bin/bash\nset -euo pipefail\n' > "$SWITCH_BACKUP/restore.sh"
  local dir="${SYSTEM_UNIT_DIR:-/etc/systemd/system}"
  for dest in "$dir/$UNIT" "$dir/$UNIT.pre-session" \
      "$dir/$UNIT.d/zz-session-retired.conf" \
      "$SDDM_CONF_DIR/zz-gamecore-autologin.conf" \
      "$SDDM_CONF_DIR/zz-gamecore-autologin.conf.pre-session"; do
    saved="$SWITCH_BACKUP/files$dest"
    if [[ -e "$dest" || -L "$dest" ]]; then
      mkdir -p "$(dirname "$saved")"
      cp -a -- "$dest" "$saved"
      printf 'rm -f -- %q; cp -a -- %q %q\n' "$dest" "$saved" "$dest" >> "$SWITCH_BACKUP/restore.sh"
    else
      printf 'rm -f -- %q\n' "$dest" >> "$SWITCH_BACKUP/restore.sh"
    fi
  done
  printf 'systemctl daemon-reload\n' >> "$SWITCH_BACKUP/restore.sh"
  local enabled
  enabled=$(systemctl is-enabled "$UNIT" 2>/dev/null || true)
  case "$enabled" in
    enabled) printf 'systemctl enable %q\n' "$UNIT" >> "$SWITCH_BACKUP/restore.sh" ;;
    disabled) printf 'systemctl disable %q\n' "$UNIT" >> "$SWITCH_BACKUP/restore.sh" ;;
  esac
  echo "Undo this switch: sudo bash $SWITCH_BACKUP/restore.sh"
}

# Do not stop the current UI here: this command can be its child (Desktop
# Mode). Disable future starts, keep the original unit, and mask new starts.
retire_legacy() {
  local dir="${SYSTEM_UNIT_DIR:-/etc/systemd/system}" old
  old="$dir/$UNIT"
  if [[ -f "$old" && ! -L "$old" ]]; then
    if [[ ! -e "$old.pre-session" ]]; then cp -a "$old" "$old.pre-session"; fi
    systemctl disable "$UNIT"
    # A running process is left until logout; Restart=no prevents it returning
    # over the new session if the old display closes with an error.
    mkdir -p "$dir/$UNIT.d"
    printf '[Service]\nRestart=no\n' > "$dir/$UNIT.d/zz-session-retired.conf"
    ln -sf /dev/null "$old"
    systemctl daemon-reload
  fi
}

# Make the choice above the one that is actually running, by restarting the
# display manager.
#
# Writing the drop-in is not applying it. SDDM reads /etc/sddm.conf.d when the
# DAEMON starts; ending a session only makes it build a new display, and with
# Relogin=true it logs straight back into the session it was told about at its
# own start. On the reference box that is a loop with no way out from the sofa:
# "Mode bureau" ended the session, the screen went black, and GameCore came
# back — the file said `desktop`, the running daemon still said `gamecore`.
#
# Not the default, and not something `status` or an arming does: run over SSH
# this would end whatever session the operator is sitting in. It is one
# explicitly granted command, used by the one caller that means it — the
# interface, whose session is ending anyway.
#
# --no-block because this process is inside the session the restart tears down:
# a systemctl that waits for the job to finish is a systemctl that gets killed
# while waiting, and returns failure for something that worked.
_restart_dm() {
  local unit
  for unit in display-manager.service sddm.service; do
    systemctl cat "$unit" >/dev/null 2>&1 || continue
    echo "restarting $unit — a display manager only reads its configuration at start."
    systemctl restart --no-block "$unit" || {
      echo "could not restart $unit — log out to apply the change." >&2
      return 1
    }
    return 0
  done
  echo "no display manager unit here — log out to apply the change." >&2
  return 1
}

if [[ "$MODE" == gamecore ]]; then
  if [[ ! -f "$XSESSIONS_DIR/gamecore.desktop" ]]; then
    echo "no gamecore.desktop on this machine — this box has not been migrated." >&2
    echo "  run: sudo install/steps/setup-gamecore-session.sh <user> <path> <data> <port>" >&2
    exit 1
  fi
  # A console session with no window manager is worse than no console session:
  # the interface shows, so it looks like it worked, and then the bezels stack
  # at random and a fullscreen emulator answers to nobody. Recent Plasma ships
  # KWin's X11 binary separately, so a box running Plasma on Wayland has none —
  # which is exactly what the reference box turned out to be, one command
  # before this would have armed it.
  #
  # Refused rather than warned: this is the one command in the whole project
  # that can leave somebody in front of a television with a half-working
  # console, and a warning scrolls past on a screen nobody is reading.
  if ! $FORCE; then
    HAVE_WM=""
    # Same list and same override as gamecore-session, so what is checked here
    # is what will actually be looked for there.
    for wm in ${GAMECORE_WM_CANDIDATES:-kwin_x11 kwin openbox}; do
      command -v "$wm" >/dev/null 2>&1 && { HAVE_WM="$wm"; break; }
    done
    if [[ -z "$HAVE_WM" ]]; then
      echo "no X11 window manager on this machine — the console session would" >&2
      echo "have nothing to manage its windows." >&2
      echo "  install one:  sudo pacman -S kwin-x11" >&2
      echo "  or arm anyway: sudo $(basename "$0") gamecore --force" >&2
      exit 1
    fi
    [[ "$HAVE_WM" == openbox ]] && {
      echo "note: no KWin for X11 here — the session will use openbox."
      echo "  games and interface are fine; the bezels are tuned for KWin."
      echo "  for the intended behaviour:  sudo pacman -S kwin-x11"
    }
  fi
  _remember_previous "$(_autologin)"
  backup_switch
  retire_legacy
  _retire_our_leftovers
  _write_autologin gamecore "$GC_USER"
  _verify_autologin gamecore || VERIFY_FAILED=1
  echo "console session ON — the next boot opens GameCore, with no desktop behind it."
  echo "back to the desktop:  sudo $(basename "$0") desktop"
else
  # What the box was using before the console was armed, if it is still there.
  # Then the ranked X11 pick — which is what a box that has never been armed
  # wants — and finally ANY desktop, including a Wayland one: a machine whose
  # only desktop is Wayland must not be told there is nowhere to go. GameCore
  # cannot run there, and that is fine; leaving is leaving.
  DESKTOP_SESSION="$(_previous_session || true)"
  [[ -n "$DESKTOP_SESSION" ]] || DESKTOP_SESSION="$(_pick --x11 || true)"
  [[ -n "$DESKTOP_SESSION" ]] || DESKTOP_SESSION="$(_pick || true)"
  if [[ -z "$DESKTOP_SESSION" ]]; then
    echo "no desktop session is installed — nothing to fall back to." >&2
    echo "  install one (e.g. plasma-desktop) before leaving the console session." >&2
    exit 1
  fi
  backup_switch
  retire_legacy
  _retire_our_leftovers
  _write_autologin "$DESKTOP_SESSION" "$GC_USER"
  _verify_autologin "$DESKTOP_SESSION" || VERIFY_FAILED=1
  echo "desktop ON — the next boot opens '$DESKTOP_SESSION'."
  echo "back to the console:  sudo $(basename "$0") gamecore"
fi

# An arming that was overridden is not an arming. The message above says which
# file won; the exit code says it to whatever ran this. Checked BEFORE the
# restart below: tearing the screen down to apply a choice that did not take is
# how you turn a wrong auto-login into a wrong auto-login with no session left
# to fix it from.
[[ -n "${VERIFY_FAILED:-}" ]] && exit 1

if $RESTART_DM; then
  echo
  _restart_dm || exit 1
  exit 0
fi

# The session that is running now is not the one that was just chosen. Ending
# it here would drop the player onto a greeter mid-sentence; it is theirs to
# do, and saying so is the whole difference between a switch and a surprise.
if systemctl --user -M "${GC_USER}@" is-active --quiet gamecore-session.target 2>/dev/null \
   || systemctl is-active --quiet "$UNIT" 2>/dev/null; then
  echo
  echo "GameCore is running right now — the change takes effect at the next login."
  echo "  now, if you want it now:  sudo $(basename "$0") $MODE --restart-dm"
fi
exit 0
