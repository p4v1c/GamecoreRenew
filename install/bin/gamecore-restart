#!/usr/bin/env bash
# Detached OTA restart, run as root by gamecore-restart.service.
#
# The one thing it needs is WHO the GameCore user is, and it used to take that
# from the installer's manifest alone. That file is not on every box — one
# installed before it existed has none — and `source` under `set -e` then kills
# the restart: the update completes, writes the new version, asks for the
# restart, and the box keeps running the old code with nothing on screen to say
# why. Measured on the reference machine, twice in one evening.
#
# So the same two sources as gamecore-session-migrate: the manifest when it is
# there, otherwise the backend's own unit, which carries `User=` and is
# root-owned. Deliberately a copy rather than a shared library — this file is
# installed to /usr/local/bin on its own and must not depend on a checkout.
set -euo pipefail
manifest="${GAMECORE_MANIFEST:-/var/lib/gamecore/manifest.env}"
unit="${GAMECORE_BACKEND_UNIT:-gamecore-backend.service}"

USER_NAME=""
if [[ -r "$manifest" ]]; then
  # Read in a subshell: a stray line in a file this script does not own has no
  # business redefining anything here.
  USER_NAME="$(
    set -euo pipefail
    # shellcheck disable=SC1090
    source "$manifest"
    printf '%s' "${USER_NAME:-}"
  )" || USER_NAME=""
fi
if [[ -z "$USER_NAME" ]]; then
  USER_NAME="$(systemctl show "$unit" -p User --value 2>/dev/null || true)"
fi
if [[ -z "$USER_NAME" ]]; then
  echo "gamecore-restart: cannot tell which user runs GameCore" >&2
  echo "  tried: $manifest, then the $unit unit." >&2
  exit 1
fi

systemctl restart gamecore-backend.service
userctl() { systemctl --user -M "${USER_NAME}@" "$@"; }
# Preserve desktop mode: restart the UI only if one is already running, or
# if the console session owns it. Never start an inactive legacy kiosk.
if userctl is-active --quiet gamecore-session.target || userctl is-active --quiet gamecore-ui.service; then
  userctl daemon-reload
  userctl restart gamecore-ui.service
elif systemctl is-active --quiet gamecore-ui.service; then
  systemctl restart gamecore-ui.service
fi
